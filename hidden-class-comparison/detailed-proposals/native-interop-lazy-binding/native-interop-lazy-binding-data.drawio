<mxfile host="app.diagrams.net" modified="2026-08-18T00:00:00.000Z" agent="Hermes Agent" version="24.7.17">
  <diagram id="native-interop-data" name="关键数据结构关系">
    <mxGraphModel dx="1500" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Native Interop 惰性绑定：关键数据结构与生命周期" style="text;html=1;align=left;fontSize=24;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="50" y="24" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="legend" value="蓝色：现有结构/路径　绿色：候选新增结构　紫色：物化后结构　虚线：候选或条件关系" style="text;html=1;align=left;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="50" y="68" width="1050" height="28" as="geometry"/></mxCell>
        <mxCell id="input" value="现有输入&lt;br&gt;&lt;b&gt;napi_property_descriptor[]&lt;/b&gt;&lt;br&gt;utf8name / method / getter / setter&lt;br&gt;data / attributes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="65" y="145" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="lifetime" value="候选新增：ClassBindingLifetime&lt;br&gt;类 / module unload 生命周期所有者&lt;br&gt;负责 descriptor 与未物化资源释放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="405" y="125" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="table" value="候选新增：NativeLazyDescriptorTable&lt;br&gt;每项保存 key / callback / data / attrs / state&lt;br&gt;深拷贝 72–96 B/项，或静态存储期零拷贝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="405" y="275" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="a1" value="A1 备选&lt;br&gt;module exports[className]&lt;br&gt;→ 现有 InternalAccessor (24 B)&lt;br&gt;→ 指向类级 materialize callback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0891b2;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="120" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="prototype" value="现有：prototype JSObject&lt;br&gt;持有 HClass + property storage&lt;br&gt;方法 key 由 LayoutInfo 描述" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="285" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="layout" value="现有：JSHClass / LayoutInfo&lt;br&gt;key + PropertyAttributes + slot offset&lt;br&gt;prototype marker / EnumCache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1130" y="285" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="a2smi" value="A2 形态二（候选主方向）&lt;br&gt;PropertyAttributes.lazy = 1&lt;br&gt;value slot = Smi(descriptor index)&lt;br&gt;零额外堆对象/方法" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="455" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="a2accessor" value="A2 形态一（低侵入备选）&lt;br&gt;每方法 InternalAccessor (24 B)&lt;br&gt;getter 不接收属性 key&lt;br&gt;因此不能单例复用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1130" y="455" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="lookup" value="现有路径扩展点&lt;br&gt;&lt;b&gt;JSObject::GetProperty / LoadIC&lt;/b&gt;&lt;br&gt;识别 lazy attr → CAS/锁定 slot → 查 descriptor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="635" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="function" value="物化后：JSFunction&lt;br&gt;name / length / Method&lt;br&gt;prototype.m 连续读取返回同一对象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="790" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="pointer" value="物化后：JSNativePointer&lt;br&gt;HashField 持有 native pointer wrapper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="725" y="790" width="235" height="95" as="geometry"/></mxCell>
        <mxCell id="info" value="堆外：NapiFunctionInfo&lt;br&gt;callback / data / env / scopeId&lt;br&gt;CommonDeleter 负责释放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fae8ff;strokeColor=#c026d3;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1045" y="790" width="245" height="95" as="geometry"/></mxCell>
        <mxCell id="ic" value="物化写回后的现有失效链&lt;br&gt;HClass transition → MarkProtoChanged&lt;br&gt;RefreshUsers / IC handler invalidate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7e22ce;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1170" y="635" width="260" height="105" as="geometry"/></mxCell>
        <mxCell id="e1" value="定义时输入" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16a34a;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="input" target="lifetime"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="owns" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="lifetime" target="table"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="类级索引" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0891b2;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="a1" target="table"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="735" y="178"/><mxPoint x="735" y="305"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="hclass" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="prototype" target="layout"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="slot 表示" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16a34a;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="prototype" target="a2smi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="备选 slot 值" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d97706;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=11;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prototype" target="a2accessor"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="425"/><mxPoint x="1270" y="425"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" value="descriptor index" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="a2smi" target="table"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="520"/><mxPoint x="720" y="360"/></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="首次读取" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="a2smi" target="lookup"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d97706;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;entryX=0.833;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2accessor" target="lookup"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="600"/><mxPoint x="1100" y="600"/><mxPoint x="1100" y="610"/><mxPoint x="1020" y="610"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="创建" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#7c3aed;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="lookup" target="function"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="HashField" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9333ea;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="function" target="pointer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="native payload" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#c026d3;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="pointer" target="info"><mxGeometry relative="1" as="geometry"/></mxCell>
