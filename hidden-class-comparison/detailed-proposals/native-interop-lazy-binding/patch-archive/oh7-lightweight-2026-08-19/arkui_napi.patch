+struct PendingNativeInteropFunction final {
+    NapiFunctionInfo *info {nullptr};
+    NativeInteropRole role {NativeInteropRole::PROTOTYPE_METHOD};
+};
+
+static bool IsNativeInteropUsageCollectionEnabled()
+{
+#if defined(ENABLE_HITRACE) && !defined(PREVIEW) && !defined(ANDROID_PLATFORM) && !defined(IOS_PLATFORM)
+    return OHOS::system::GetBoolParameter("hiviewdfx.hiprofiler.nativeinterop.enabled", false);
+#else
+    return false;
+#endif
+}
+
+static std::string GetNativeInteropUsageTargetBundle()
+{
+#if defined(ENABLE_HITRACE) && !defined(PREVIEW) && !defined(ANDROID_PLATFORM) && !defined(IOS_PLATFORM)
+    return OHOS::system::GetParameter("hiviewdfx.hiprofiler.nativeinterop.bundle", "");
+#else
+    return "";
+#endif
+}
+
+#if defined(ENABLE_HITRACE) && !defined(PREVIEW) && !defined(ANDROID_PLATFORM) && !defined(IOS_PLATFORM)
+static constexpr const char *NATIVE_INTEROP_USAGE_PARAMETER_PREFIX = "hiviewdfx.hiprofiler.nativeinterop.";
+static std::mutex g_nativeInteropUsageWatcherMutex;
+static bool g_nativeInteropUsageWatcherRegistered = false;
+
+static void NativeInteropUsageParameterChanged(const char *key, const char *value, void *context)
+{
+    (void)key;
+    (void)value;
+    (void)context;
+    NativeInteropUsageRegistry::Refresh(IsNativeInteropUsageCollectionEnabled(),
+                                        GetNativeInteropUsageTargetBundle());
+}
+
+static bool EnsureNativeInteropUsageParameterWatcher()
+{
+    std::lock_guard<std::mutex> lock(g_nativeInteropUsageWatcherMutex);
+    if (g_nativeInteropUsageWatcherRegistered) {
+        return true;
+    }
+    if (WatchParameter(NATIVE_INTEROP_USAGE_PARAMETER_PREFIX, NativeInteropUsageParameterChanged, nullptr) != 0) {
+        HILOG_ERROR("NativeInteropUsage parameter watcher registration failed");
+        return false;
+    }
+    g_nativeInteropUsageWatcherRegistered = true;
+    return true;
+}
+#endif
+
+static bool EnableNativeInteropUsageForTarget(napi_env env)
+{
+#if defined(ENABLE_HITRACE) && !defined(PREVIEW) && !defined(ANDROID_PLATFORM) && !defined(IOS_PLATFORM)
+    auto vm = const_cast<EcmaVM *>(reinterpret_cast<NativeEngine *>(env)->GetEcmaVm());
+    bool enabled = IsNativeInteropUsageCollectionEnabled();
+    std::string targetBundle = GetNativeInteropUsageTargetBundle();
+    std::string bundleName = JSNApi::GetBundleName(vm);
+    if (!enabled || targetBundle.empty() || bundleName.empty() || targetBundle != bundleName) {
+        NativeInteropUsageRegistry::Disable(vm);
+        return false;
+    }
+    if (!EnsureNativeInteropUsageParameterWatcher()) {
+        NativeInteropUsageRegistry::Disable(vm);
+        return false;
+    }
+    NativeInteropUsageRegistry::Refresh(enabled, targetBundle);
+    NativeInteropUsageRegistry::Enable(vm, bundleName);
+    NativeInteropUsageRegistry::Refresh(IsNativeInteropUsageCollectionEnabled(),
+                                        GetNativeInteropUsageTargetBundle());
+    return NativeInteropUsageRegistry::IsEnabled(vm);
+#else
+    (void)env;
+    return false;
+#endif
+}
