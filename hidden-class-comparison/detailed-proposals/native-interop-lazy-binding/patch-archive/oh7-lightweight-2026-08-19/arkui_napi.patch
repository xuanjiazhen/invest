+
+#include "native_interop_usage_registry.h"
+
+#include <array>
+#include <atomic>
+#include <cinttypes>
+#include <cstddef>
+#include <cstring>
+#include <mutex>
+#include <new>
+
+#include "native_engine/native_value.h"
+#include "utils/log.h"
+
+namespace {
+constexpr uint8_t STATE_CALLED = 1U << 0U;
+constexpr size_t BUCKET_COUNT = 16384;
+constexpr size_t MAX_BUNDLE_NAME_LENGTH = 256;
+
+struct VmStats final {
+    panda::ecmascript::EcmaVM *vm {nullptr};
+    char bundleName[MAX_BUNDLE_NAME_LENGTH] {};
+    VmStats *next {nullptr};
+};
+
+struct ClassGroup final {
+    VmStats *stats {nullptr};
+    NapiFunctionInfo *constructorInfo {nullptr};
+    bool instantiated {false};
+    size_t entryCount {0};
+    ClassGroup *next {nullptr};
+};
+
+struct Entry final {
+    NapiFunctionInfo *info {nullptr};
+    VmStats *stats {nullptr};
+    ClassGroup *group {nullptr};
+    Entry *next {nullptr};
+    NativeInteropRole role {NativeInteropRole::PROTOTYPE_METHOD};
+    uint8_t state {0};
+};
+
+using BucketArray = std::array<Entry *, BUCKET_COUNT>;
+
+struct RegistryState final {
+    std::mutex mutex;
+    BucketArray *buckets {nullptr};
+    VmStats *vmStatsHead {nullptr};
+    ClassGroup *classGroups {nullptr};
+    std::atomic<uint32_t> enabledVmCount {0};
+};
+
+std::atomic<RegistryState *> g_registryState {nullptr};
+std::mutex g_registryInitMutex;
+
+RegistryState *GetRegistryState()
+{
+    return g_registryState.load(std::memory_order_acquire);
+}
+
+RegistryState *GetOrCreateRegistryState()
+{
+    RegistryState *state = GetRegistryState();
+    if (state != nullptr) {
+        return state;
+    }
+    std::lock_guard<std::mutex> lock(g_registryInitMutex);
+    state = GetRegistryState();
+    if (state == nullptr) {
+        state = new (std::nothrow) RegistryState();
+        if (state != nullptr) {
+            g_registryState.store(state, std::memory_order_release);
+        }
+    }
+    return state;
+}
+
+size_t BucketIndex(const NapiFunctionInfo *info)
+{
+    uintptr_t value = reinterpret_cast<uintptr_t>(info);
+    return ((value >> 4U) ^ (value >> 20U)) & (BUCKET_COUNT - 1U);
+}
+
+VmStats *FindVmStatsLocked(RegistryState &state, panda::ecmascript::EcmaVM *vm)
+{
+    for (VmStats *stats = state.vmStatsHead; stats != nullptr; stats = stats->next) {
+        if (stats->vm == vm) {
+            return stats;
+        }
+    }
+    return nullptr;
+}
+
+Entry **FindEntrySlotLocked(RegistryState &state, NapiFunctionInfo *info)
+{
+    if (info == nullptr || state.buckets == nullptr) {
+        return nullptr;
+    }
+    Entry **slot = &(*state.buckets)[BucketIndex(info)];
+    while (*slot != nullptr && (*slot)->info != info) {
+        slot = &(*slot)->next;
+    }
+    return slot;
+}
+
+ClassGroup *FindClassGroupLocked(RegistryState &state, VmStats *stats, NapiFunctionInfo *constructorInfo)
+{
+    for (ClassGroup *group = state.classGroups; group != nullptr; group = group->next) {
+        if (group->stats == stats && group->constructorInfo == constructorInfo) {
+            return group;
+        }
+    }
+    return nullptr;
+}
+
+ClassGroup *CreateClassGroupLocked(RegistryState &state, VmStats *stats, NapiFunctionInfo *constructorInfo)
+{
+    auto group = new (std::nothrow) ClassGroup();
+    if (group == nullptr) {
+        return nullptr;
+    }
+    group->stats = stats;
+    group->constructorInfo = constructorInfo;
+    group->next = state.classGroups;
+    state.classGroups = group;
+    return group;
+}
+
+void DeleteClassGroupLocked(RegistryState &state, ClassGroup *group)
+{
+    ClassGroup **slot = &state.classGroups;
+    while (*slot != nullptr && *slot != group) {
+        slot = &(*slot)->next;
+    }
+    if (*slot != nullptr) {
+        *slot = group->next;
+        delete group;
+    }
+}
+
+void DeleteEntryLocked(RegistryState &state, Entry **slot)
+{
+    if (slot == nullptr || *slot == nullptr) {
+        return;
+    }
+    Entry *entry = *slot;
+    *slot = entry->next;
+    ClassGroup *group = entry->group;
+    if (entry->role == NativeInteropRole::CONSTRUCTOR && group != nullptr &&
+        group->constructorInfo == entry->info) {
+        group->constructorInfo = nullptr;
+    }
+    delete entry;
+    if (group != nullptr && group->entryCount > 0 && --group->entryCount == 0) {
+        DeleteClassGroupLocked(state, group);
+    }
+}
+
+void DeleteVmEntriesLocked(RegistryState &state, VmStats *stats)
+{
+    if (state.buckets == nullptr) {
+        return;
+    }
+    for (Entry *&head : *state.buckets) {
+        Entry **slot = &head;
+        while (*slot != nullptr) {
+            if ((*slot)->stats == stats) {
+                DeleteEntryLocked(state, slot);
+            } else {
+                slot = &(*slot)->next;
+            }
+        }
+    }
+}
+
+void DeleteVmLocked(RegistryState &state, VmStats **slot)
+{
+    VmStats *stats = *slot;
+    DeleteVmEntriesLocked(state, stats);
+    *slot = stats->next;
+    delete stats;
+    uint32_t count = state.enabledVmCount.load(std::memory_order_relaxed);
+    state.enabledVmCount.store(count > 0 ? count - 1 : 0, std::memory_order_release);
+    if (state.enabledVmCount.load(std::memory_order_relaxed) == 0) {
+        delete state.buckets;
+        state.buckets = nullptr;
+    }
+}
+
+struct Snapshot final {
+    uint64_t zeroInstanceClasses = 0;
+    uint64_t bucketCClosures = 0;
+    uint64_t bucketCNeverCalled = 0;
+    uint64_t constructors = 0;
+    uint64_t prototypeMethods = 0;
+    uint64_t prototypeGetters = 0;
+    uint64_t prototypeSetters = 0;
+};
+
+Snapshot BuildSnapshotLocked(const RegistryState &state, const VmStats *stats)
+{
+    Snapshot result;
+    for (const ClassGroup *group = state.classGroups; group != nullptr; group = group->next) {
+        if (group->stats == stats && !group->instantiated) {
+            ++result.zeroInstanceClasses;
+        }
+    }
+    if (state.buckets == nullptr) {
+        return result;
+    }
+    for (const Entry *head : *state.buckets) {
+        for (const Entry *entry = head; entry != nullptr; entry = entry->next) {
+            if (entry->stats != stats) {
+                continue;
+            }
+            switch (entry->role) {
+                case NativeInteropRole::CONSTRUCTOR:
+                    ++result.constructors;
+                    break;
+                case NativeInteropRole::PROTOTYPE_METHOD:
+                    ++result.prototypeMethods;
+                    break;
+                case NativeInteropRole::PROTOTYPE_GETTER:
+                    ++result.prototypeGetters;
+                    break;
+                case NativeInteropRole::PROTOTYPE_SETTER:
+                    ++result.prototypeSetters;
+                    break;
+                default:
+                    break;
+            }
+            if (entry->group != nullptr && !entry->group->instantiated) {
+                ++result.bucketCClosures;
+                if ((entry->state & STATE_CALLED) == 0) {
+                    ++result.bucketCNeverCalled;
+                }
+            }
+        }
+    }
+    return result;
+}
+
+void LogSnapshot(const Snapshot &snapshot, bool isFinal)
+{
+    HILOG_INFO("NativeInteropUsage checkpoint=%{public}s zeroInstanceClasses=%{public}" PRIu64
+        " bucketCClosures=%{public}" PRIu64 " bucketCNeverCalled=%{public}" PRIu64
+        " constructors=%{public}" PRIu64 " prototypeMethods=%{public}" PRIu64
+        " prototypeGetters=%{public}" PRIu64 " prototypeSetters=%{public}" PRIu64,
+        isFinal ? "final" : "napi_pre_heapdump", snapshot.zeroInstanceClasses, snapshot.bucketCClosures,
+        snapshot.bucketCNeverCalled, snapshot.constructors, snapshot.prototypeMethods,
+        snapshot.prototypeGetters, snapshot.prototypeSetters);
+}
+} // namespace
+
+void NativeInteropUsageRegistry::Enable(panda::ecmascript::EcmaVM *vm, const std::string &bundleName)
+{
+#ifndef ENABLE_HITRACE
+    (void)vm;
+    (void)bundleName;
+#else
+    if (vm == nullptr || bundleName.empty() || bundleName.size() >= MAX_BUNDLE_NAME_LENGTH) {
+        return;
+    }
+    RegistryState *state = GetOrCreateRegistryState();
+    if (state == nullptr) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(state->mutex);
+    if (FindVmStatsLocked(*state, vm) != nullptr) {
+        return;
+    }
+    if (state->buckets == nullptr) {
+        state->buckets = new (std::nothrow) BucketArray();
+        if (state->buckets == nullptr) {
+            return;
+        }
+        state->buckets->fill(nullptr);
+    }
+    auto stats = new (std::nothrow) VmStats();
+    if (stats == nullptr) {
+        if (state->enabledVmCount.load(std::memory_order_relaxed) == 0) {
+            delete state->buckets;
+            state->buckets = nullptr;
+        }
+        return;
+    }
+    stats->vm = vm;
+    (void)memcpy(stats->bundleName, bundleName.data(), bundleName.size());
+    stats->bundleName[bundleName.size()] = '\0';
+    stats->next = state->vmStatsHead;
+    state->vmStatsHead = stats;
+    state->enabledVmCount.fetch_add(1, std::memory_order_release);
+#endif
+}
+
+bool NativeInteropUsageRegistry::IsEnabled(panda::ecmascript::EcmaVM *vm)
+{
+#ifndef ENABLE_HITRACE
+    (void)vm;
+    return false;
+#else
+    RegistryState *state = GetRegistryState();
+    if (vm == nullptr || state == nullptr || state->enabledVmCount.load(std::memory_order_acquire) == 0) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(state->mutex);
+    return FindVmStatsLocked(*state, vm) != nullptr;
+#endif
+}
+
+void NativeInteropUsageRegistry::Refresh(bool enabled, const std::string &targetBundle)
+{
+#ifdef ENABLE_HITRACE
+    RegistryState *state = GetRegistryState();
+    if (state == nullptr || state->enabledVmCount.load(std::memory_order_acquire) == 0) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(state->mutex);
+    VmStats **slot = &state->vmStatsHead;
+    while (*slot != nullptr) {
+        bool matches = enabled && !targetBundle.empty() && targetBundle == (*slot)->bundleName;
+        if (!matches) {
+            DeleteVmLocked(*state, slot);
+        } else {
+            slot = &(*slot)->next;
+        }
+    }
+#else
+    (void)enabled;
+    (void)targetBundle;
+#endif
+}
+
+void NativeInteropUsageRegistry::Disable(panda::ecmascript::EcmaVM *vm)
+{
+#ifdef ENABLE_HITRACE
+    RegistryState *state = GetRegistryState();
+    if (vm == nullptr || state == nullptr || state->enabledVmCount.load(std::memory_order_acquire) == 0) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(state->mutex);
+    VmStats **slot = &state->vmStatsHead;
+    while (*slot != nullptr && (*slot)->vm != vm) {
+        slot = &(*slot)->next;
+    }
+    if (*slot != nullptr) {
+        DeleteVmLocked(*state, slot);
+    }
+#else
+    (void)vm;
+#endif
+}
+
+void NativeInteropUsageRegistry::Register(NapiFunctionInfo *info, panda::ecmascript::EcmaVM *vm,
+                                          NativeInteropRole role, NapiFunctionInfo *constructorInfo)
+{
+#ifdef ENABLE_HITRACE
+    RegistryState *state = GetRegistryState();
+    if (info == nullptr || vm == nullptr || state == nullptr ||
+        state->enabledVmCount.load(std::memory_order_acquire) == 0) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(state->mutex);
+    VmStats *stats = FindVmStatsLocked(*state, vm);
+    Entry **entrySlot = FindEntrySlotLocked(*state, info);
+    if (stats == nullptr || entrySlot == nullptr || *entrySlot != nullptr) {
+        return;
+    }
+    NapiFunctionInfo *groupKey = constructorInfo == nullptr ? info : constructorInfo;
+    ClassGroup *group = role == NativeInteropRole::CONSTRUCTOR ?
+        CreateClassGroupLocked(*state, stats, groupKey) : FindClassGroupLocked(*state, stats, groupKey);
+    if (group == nullptr) {
+        return;
+    }
+    auto entry = new (std::nothrow) Entry();
+    if (entry == nullptr) {
+        if (role == NativeInteropRole::CONSTRUCTOR && group->entryCount == 0) {
+            DeleteClassGroupLocked(*state, group);
+        }
+        return;
+    }
+    entry->info = info;
+    entry->stats = stats;
+    entry->group = group;
+    entry->role = role;
+    entry->next = *entrySlot;
+    *entrySlot = entry;
+    ++group->entryCount;
+#else
+    (void)info;
+    (void)vm;
+    (void)role;
+    (void)constructorInfo;
+#endif
+}
+
+void NativeInteropUsageRegistry::Unregister(NapiFunctionInfo *info)
+{
+#ifdef ENABLE_HITRACE
+    RegistryState *state = GetRegistryState();
+    if (info == nullptr || state == nullptr || state->enabledVmCount.load(std::memory_order_acquire) == 0) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(state->mutex);
+    Entry **slot = FindEntrySlotLocked(*state, info);
+    if (slot != nullptr && *slot != nullptr) {
+        DeleteEntryLocked(*state, slot);
+    }
+#else
+    (void)info;
+#endif
+}
+
+void NativeInteropUsageRegistry::RecordCall(NapiFunctionInfo *info, bool isConstructCall)
+{
+#ifdef ENABLE_HITRACE
+    RegistryState *state = GetRegistryState();
+    if (info == nullptr || state == nullptr || state->enabledVmCount.load(std::memory_order_acquire) == 0) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(state->mutex);
+    Entry **slot = FindEntrySlotLocked(*state, info);
+    if (slot == nullptr || *slot == nullptr) {
+        return;
+    }
+    Entry *entry = *slot;
+    entry->state |= STATE_CALLED;
+    if (isConstructCall && entry->role == NativeInteropRole::CONSTRUCTOR && entry->group != nullptr) {
+        entry->group->instantiated = true;
+    }
+#else
+    (void)info;
+    (void)isConstructCall;
+#endif
+}
+
+void NativeInteropUsageRegistry::Checkpoint(panda::ecmascript::EcmaVM *vm, bool isFinal)
+{
+#ifdef ENABLE_HITRACE
+    Snapshot snapshot;
+    {
+        RegistryState *state = GetRegistryState();
+        if (state == nullptr || state->enabledVmCount.load(std::memory_order_acquire) == 0) {
+            return;
+        }
+        std::lock_guard<std::mutex> lock(state->mutex);
+        VmStats *stats = FindVmStatsLocked(*state, vm);
+        if (stats == nullptr) {
+            return;
+        }
+        snapshot = BuildSnapshotLocked(*state, stats);
+    }
+    LogSnapshot(snapshot, isFinal);
+#else
+    (void)vm;
+    (void)isFinal;
+#endif
+}
