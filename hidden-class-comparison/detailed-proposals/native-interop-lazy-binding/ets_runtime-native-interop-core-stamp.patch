+void JSTaggedValue::NotifyNativeInteropUsage(JSThread *thread, JSTaggedValue value,
+                                             NativeInteropUsageEvent event)
+{
+    auto callback = thread->GetEcmaVM()->GetNativeInteropUsageCallback();
+    if (callback == nullptr || !value.IsJSFunction()) {
+        return;
+    }
+    JSHandle<JSFunctionBase> function(thread, value);
+    JSTaggedValue extraInfo = function->GetFunctionExtraInfo(thread);
+    if (!extraInfo.IsJSNativePointer()) {
+        return;
+    }
+    auto nativePointer = JSNativePointer::Cast(extraInfo.GetTaggedObject());
+    callback(thread->GetEcmaVM(), nativePointer->GetData(), static_cast<uint8_t>(event));
+}
+
+
+static OperationResult ObserveNativeInteropRead(JSThread *thread, OperationResult result)
+{
+    JSTaggedValue::NotifyNativeInteropUsage(thread, result.GetValue().GetTaggedValue(),
+                                            NativeInteropUsageEvent::READ);
+    return result;
+}
