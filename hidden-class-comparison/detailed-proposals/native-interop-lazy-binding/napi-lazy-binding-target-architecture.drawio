<mxfile host="app.diagrams.net" agent="Hermes Agent via @drawio/mcp 1.5.0" version="1.5.0"><diagram id="napi-31-target" name="3.1 目标架构"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Prototype native 方法按需绑定：目标架构" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172B4D;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="42" as="geometry" /></mxCell><mxCell id="subtitle" value="普通非 Sendable prototype 方法按首次读取创建&lt;div&gt;constructor 与其他属性使用即时创建路径&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5E6C84;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1420" height="34" as="geometry" /></mxCell><mxCell id="reg" value="注册期（惰性化后）" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;arcSize=6;fillColor=#F4F5F7;swimlaneFillColor=#FFFFFF;strokeColor=#6B778C;strokeWidth=1.5;fontSize=14;fontStyle=1;fontColor=#172B4D;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1420" height="390" as="geometry" /></mxCell><mxCell id="api" value="napi_define_class&lt;br&gt;env / name / ctor / props[]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="90" y="170" width="230" height="70" as="geometry" /></mxCell><mxCell id="life" value="ClassBindingLifetime（堆外，每类一个）&lt;br&gt;每个 LAZY 槽独立 recipe：16 B payload&lt;br&gt;tagged slotDirectory：8 B/eligible slot&lt;br&gt;&lt;b&gt;所有权：env cleanup 链&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fon