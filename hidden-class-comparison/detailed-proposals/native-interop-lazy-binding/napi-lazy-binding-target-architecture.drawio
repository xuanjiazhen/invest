<mxfile host="app.diagrams.net" agent="Hermes Agent via @drawio/mcp 1.5.0" version="1.5.0"><diagram id="napi-31-target" name="3.1 目标架构"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="InternalAccessor 迁移 NAPI：目标架构" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172B4D;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="42" as="geometry" /></mxCell><mxCell id="subtitle" value="A1 推迟整类 define_class；A2 形态一保留 ctor / prototype 骨架，仅推迟 prototype 方法闭包" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5E6C84;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1420" height="34" as="geometry" /></mxCell><mxCell id="reg" value="注册期（惰性化后）" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;arcSize=6;fillColor=#F4F5F7;swimlaneFillColor=#FFFFFF;strokeColor=#6B778C;strokeWidth=1.5;fontSize=14;fontStyle=1;fontColor=#172B4D;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1420" height="390" as="geometry" /></mxCell><mxCell id="api" value="napi_define_class&lt;br&gt;env / name / ctor / props[]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="90" y="170" width="230" height="70" as="geometry" /></mxCell><mxCell id="life" value="ClassBindingLifetime（堆外，每类一个）&lt;br&gt;descriptor 深拷贝：name / callback / data / attrs&lt;br&gt;NativeLazyDescriptorTable + per-slot state&lt;br&gt;&lt;b&gt;所有权：env cleanup 链&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#EAE6FF;strokeColor=#6554C0;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="390" y="145" width="450" height="120" as="geometry" /></mxCell><mxCell id="a1" value="A1：模块导出对象 className slot&lt;br&gt;NapiLazyAccessor payload=(lifetime, —)&lt;br&gt;不创建 ctor / prototype&lt;br&gt;&lt;b&gt;需要模块级 exports 归属契约&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#FFFAE6;strokeColor=#FFAB00;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="900" y="135" width="480" height="135" as="geometry" /></mxCell><mxCell id="a2" value="A2 形态一：立即创建 ctor + prototype 骨架&lt;br&gt;static / getter / setter / data 走即时路径&lt;br&gt;prototype.m[i] 安装 NapiLazyAccessor&lt;br&gt;&lt;b&gt;payload=(lifetime, descriptor index)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#E3FCEF;strokeColor=#00875A;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="900" y="310" width="480" height="135" as="geometry" /></mxCell><mxCell id="apiLife" value="深拷贝 / 建表" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0052CC;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="api" target="life"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lifeA1" value="A1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FFAB00;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" edge="1" parent="1" source="life" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lifeA2" value="A2 形态一" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jett