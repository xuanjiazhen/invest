<mxfile host="app.diagrams.net" agent="Hermes Agent via @drawio/mcp 1.5.0" version="1.5.0"><diagram id="napi-45-unload" name="4.5 Module unload"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Module unload：未物化资源释放流程" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172B4D;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="42" as="geometry" /></mxCell><mxCell id="subtitle" value="ClassBindingLifetime 由 env cleanup 链持有；只释放本机制拥有的 descriptor 拷贝，不接管 descriptor.data" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5E6C84;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1420" height="34" as="geometry" /></mxCell><mxCell id="teardown" value="模块卸载 / env teardown" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="360" height="65" as="geometry" /></mxCell><mxCell id="cleanup" value="env cleanup callback&lt;br&gt;&lt;b&gt;ClassBindingLifetime::Release&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#EAE6FF;strokeColor=#6554C0;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="530" y="245" width="440" height="80" as="geometry" /></mxCell><mxCell id="t1" value="teardown" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6554C0;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="teardown" target="cleanup"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="materialized" value="YES：已物化 slot" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#E3FCEF;strokeColor=#00875A;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="210" y="590" width="330" height="65" as="geometry" /></mxCell><mxCell id="lazy" value="NO：未物化 slot" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#FFFAE6;strokeColor=#FFAB00;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="930" y="590" width="330" height="65" as="geometry" /></mxCell><mxCell id="dead" value="所有卸载均执行&lt;br&gt;&lt;b&gt;lifetime 状态 → DEAD&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;spacing=6;fillColor=#FFEBE6;strokeColor=#DE350B;strokeWidth=2;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="570" y="350" width="360" height="70" as="geometry" /></mxCell><mxCell id="existing" value="JSFunction / JSNativePointer / NapiFunctionInfo&lt;br&gt;走现行 CommonDeleter&lt;br&gt;&lt;b&gt;不重复释放&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#E3FCEF;strokeColor=#00875A;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="180" y="720" width="390" height="115" as="geometry" /></mxCell><mxCell id="release" value="释放 descriptor 深拷贝&lt;br&gt;名称等本机制拥有的副本&lt;br&gt;&lt;b&gt;descriptor.data 仍归模块&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#FFFAE6;strokeColor=#FFAB00;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="900" y="720" width="390" height="115" as="geometry" /></mxCell><mxCell id="residual" value="卸载后残留 NapiLazyAccessor 被读取&lt;br&gt;getter 检查 DEAD&lt;br&gt;返回 undefined / 抛错策略实施时确定" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#FFEBE6;strokeColor=#DE350B;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1080" y="345" width="340" height="130" as="geometry" /></mxCell><mxCell id="contract" value="所有权闭环：已物化对象由现行 deleter 负责；未物化 descriptor 副本由 lifetime 负责；native data 不转移所有权。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#F4F5F7;strokeColor=#6B778C;strokeWidth=1.5;fontColor=#172B4D;dashed=1;" vertex="1" parent="1"><mxGeometry x="180" y="875" width="1140" height="55" as="geometry" /></mxCell><mxCell id="slotDecision" value="slot 已物化？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;spacing=4;fillColor=#FFF7D6;strokeColor=#FFAB00;strokeWidth=2;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="600" y="465" width="300" height="100" as="geometry" /></mxCell><mxCell id="cleanupDead" value="先置 DEAD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DE350B;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cleanup" target="dead"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="deadDecision" value="再释放自有资源" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6554C0;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dead" target="slotDecision"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="decisionMat" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00875A;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="slotDecision" target="materialized"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="decisionLazy" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF8B00;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="slotDecision" target="lazy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="matExisting" value="现行路径" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00875A;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="materialized" target="existing"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lazyRelease" value="lifetime owns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF8B00;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lazy" target="release"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="deadResidual" value="后续残留访问" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DE350B;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dead" target="residual"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
