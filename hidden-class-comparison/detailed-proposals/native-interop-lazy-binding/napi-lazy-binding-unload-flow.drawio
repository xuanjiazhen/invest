<mxfile host="app.diagrams.net" agent="Hermes Agent via @drawio/mcp 1.5.0" version="1.5.0"><diagram id="napi-45-unload" name="4.5 Module unload"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Environment teardown：按需绑定资源释放" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172B4D;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="42" as="geometry" /></mxCell><mxCell id="subtitle" value="ClassBindingLifetime 由 environment cleanup 链管理&lt;div&gt;先发布 DEAD 并排空 guard，再释放剩余 recipe、directory 与 token&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5E6C84;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1420" height="34" as="geometry" /></mxCell><mxCell id="teardown" value="NAPI environment teardown" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="360" height="65" as="geometry" /></mxCell><mxCell id="cleanup" value="environment cleanup callback: ClassBindingLifetime::Release" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#EAE6FF;strokeColor=#6554C0;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="530" y="245" width="440" height="80" as="geometry" /></mxCell><mxCell id="t1" value="teardown" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6554C0;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="teardown" target="cleanup"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="materialized" value="DONE：已物化 slot" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#E3FCEF;strokeColor=#00875A;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="210" y="590" width="330" height="65" as="geometry" /></mxCell><mxCell id="lazy" value="LAZY / MATERIALIZING：未完成 slot" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#FFFAE6;strokeColor=#FFAB00;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="930" y="590" width="330" height="65" as="geometry" /></mxCell><mxCell id="dead" value="发布 lifetime DEAD&lt;div&gt;阻止新 guard，并等待在途 guard 排空&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;spacing=6;fillColor=#FFEBE6;strokeColor=#DE350B;strokeWidth=2;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="570" y="350" width="360" height="70" as="geometry" /></mxCell><mxCell id="existing" value="JSFunction / JSNativePointer / NapiFunctionInfo&lt;br&gt;走现行 CommonDeleter&lt;br&gt;&lt;b&gt;不重复释放&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#E3FCEF;strokeColor=#00875A;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="180" y="720" width="390" height="115" as="geometry" /></mxCell><mxCell id="release" value="释放剩余独立 recipe blocks&lt;br&gt;释放 tagged directory + registry token&lt;br&gt;&lt;b&gt;data 目标资源仍归模块&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#FFFAE6;strokeColor=#FFAB00;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="900" y="720" width="390" height="115" as="geometry" /></mxCell><mxCell id="residual" value="teardown 后残留 NapiLazyAccessor 被读取&lt;div&gt;抛出 native binding unavailable 异常&lt;/div&gt;&lt;div&gt;不返回 undefined，不调用已卸载代码&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#FFEBE6;strokeColor=#DE350B;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1080" y="345" width="340" height="130" as="geometry" /></mxCell><mxCell id="contract" value="所有权&lt;div&gt;已物化对象由当前 deleter 管理&lt;/div&gt;&lt;div&gt;未物化 recipe/directory/token 由 lifetime 管理&lt;/div&gt;&lt;div&gt;native data 不转移所有权&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#F4F5F7;strokeColor=#6B778C;strokeWidth=1.5;fontColor=#172B4D;dashed=1;" vertex="1" parent="1"><mxGeometry x="180" y="875" width="1140" height="55" as="geometry" /></mxCell><mxCell id="slotDecision" value="guard 排空后的 slot 状态" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;spacing=4;fillColor=#FFF7D6;strokeColor=#FFAB00;strokeWidth=2;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="600" y="465" width="300" height="100" as="geometry" /></mxCell><mxCell id="cleanupDead" value="publish DEAD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DE350B;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cleanup" target="dead"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="deadDecision" value="guard drained" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6554C0;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dead" target="slotDecision"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="decisionMat" value="DONE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00875A;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="slotDecision" target="materialized"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="decisionLazy" value="LAZY / MATERIALIZING" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF8B00;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="slotDecision" target="lazy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="matExisting" value="current GC/deleter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00875A;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="materialized" target="existing"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lazyRelease" value="lifetime owns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF8B00;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lazy" target="release"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="deadResidual" value="post-teardown read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DE350B;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dead" target="residual"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel>