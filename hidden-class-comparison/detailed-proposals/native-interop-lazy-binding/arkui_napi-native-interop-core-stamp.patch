+#ifndef FOUNDATION_ACE_NAPI_NATIVE_ENGINE_IMPL_ARK_NATIVE_INTEROP_USAGE_REGISTRY_H
+#define FOUNDATION_ACE_NAPI_NATIVE_ENGINE_IMPL_ARK_NATIVE_INTEROP_USAGE_REGISTRY_H
+
+#include <cstdint>
+
+struct NapiFunctionInfo;
+
+namespace panda::ecmascript {
+class EcmaVM;
+}
+
+enum class NativeInteropRole : uint8_t {
+    CONSTRUCTOR = 0,
+    PROTOTYPE_METHOD,
+    PROTOTYPE_GETTER,
+    PROTOTYPE_SETTER,
+};
+
+class NativeInteropUsageRegistry final {
+public:
+    static void Enable(panda::ecmascript::EcmaVM *vm);
+    static void Disable(panda::ecmascript::EcmaVM *vm);
+    static void Register(NapiFunctionInfo *info, panda::ecmascript::EcmaVM *vm, NativeInteropRole role,
+                         NapiFunctionInfo *constructorInfo = nullptr);
+    static void Unregister(NapiFunctionInfo *info);
+    static void RecordCall(NapiFunctionInfo *info, bool isConstructCall);
+    static void Observe(void *vm, void *functionInfo, uint8_t event);
+
+private:
+    NativeInteropUsageRegistry() = delete;
+};
+
+#endif // FOUNDATION_ACE_NAPI_NATIVE_ENGINE_IMPL_ARK_NATIVE_INTEROP_USAGE_REGISTRY_H
diff --git a/native_engine/impl/ark/native_interop_usage_registry.cpp b/native_engine/impl/ark/native_interop_usage_registry.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7716e225c5eea0fc154c33f5985bc0aa1737b78e
--- /dev/null
+++ b/native_engine/impl/ark/native_interop_usage_registry.cpp
@@ -0,0 +1,311 @@
+/*
+ * Copyright (c) 2026 Huawei Device Co., Ltd.
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "native_interop_usage_registry.h"
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <mutex>
+#include <new>
+
+#include "native_engine/native_value.h"
+
+#ifdef ENABLE_HITRACE
+#include "hitrace_meter.h"
+#endif
+
+namespace {
+constexpr uint8_t EVENT_READ = 0;
+constexpr uint8_t EVENT_CHECKPOINT = 1;
+constexpr uint8_t STATE_READ = 1U << 0U;
+constexpr uint8_t STATE_CALLED = 1U << 1U;
+constexpr size_t BUCKET_COUNT = 16384;
+
+struct VmStats final {
+    panda::ecmascript::EcmaVM *vm {nullptr};
+    std::atomic<bool> enabled {false};
+    VmStats *next {nullptr};
+};
+
+struct ClassGroup final {
+    VmStats *stats {nullptr};
+    NapiFunctionInfo *constructorInfo {nullptr};
+    std::atomic<bool> instantiated {false};
+    ClassGroup *next {nullptr};
+};
+
+struct Entry final {
+    NapiFunctionInfo *info {nullptr};
+    VmStats *stats {nullptr};
+    ClassGroup *group {nullptr};
+    Entry *next {nullptr};
+    NativeInteropRole role {NativeInteropRole::PROTOTYPE_METHOD};
+    std::atomic<bool> active {false};
+    std::atomic<uint8_t> state {0};
+};
+
+std::array<std::atomic<Entry *>, BUCKET_COUNT> g_buckets {};
+std::atomic<VmStats *> g_vmStatsHead {nullptr};
+std::atomic<ClassGroup *> g_classGroups {nullptr};
+std::mutex g_lifecycleMutex;
+std::atomic<uint32_t> g_enabledVmCount {0};
+
+size_t BucketIndex(const NapiFunctionInfo *info)
+{
+    uintptr_t value = reinterpret_cast<uintptr_t>(info);
+    return ((value >> 4U) ^ (value >> 20U)) & (BUCKET_COUNT - 1U);
+}
+
+VmStats *FindEnabledVmStats(panda::ecmascript::EcmaVM *vm)
+{
+    for (VmStats *stats = g_vmStatsHead.load(std::memory_order_acquire); stats != nullptr; stats = stats->next) {
+        if (stats->vm == vm && stats->enabled.load(std::memory_order_acquire)) {
+            return stats;
+        }
+    }
+    return nullptr;
+}
+
+Entry *FindActiveEntry(NapiFunctionInfo *info)
+{
+    if (info == nullptr || g_enabledVmCount.load(std::memory_order_relaxed) == 0) {
+        return nullptr;
+    }
+    for (Entry *entry = g_buckets[BucketIndex(info)].load(std::memory_order_acquire);
+         entry != nullptr; entry = entry->next) {
+        if (entry->info == info && entry->active.load(std::memory_order_acquire)) {
+            return entry;
+        }
+    }
+    return nullptr;
+}
+
+ClassGroup *FindClassGroup(VmStats *stats, NapiFunctionInfo *constructorInfo)
+{
+    for (ClassGroup *group = g_classGroups.load(std::memory_order_acquire);
+         group != nullptr; group = group->next) {
+        if (group->stats == stats && group->constructorInfo == constructorInfo) {
+            return group;
+        }
+    }
+    return nullptr;
+}
+
+ClassGroup *CreateClassGroup(VmStats *stats, NapiFunctionInfo *constructorInfo)
+{
+    auto group = new (std::nothrow) ClassGroup();
+    if (group == nullptr) {
+        return nullptr;
+    }
+    group->stats = stats;
+    group->constructorInfo = constructorInfo;
+    ClassGroup *head = g_classGroups.load(std::memory_order_relaxed);
+    do {
+        group->next = head;
+    } while (!g_classGroups.compare_exchange_weak(head, group, std::memory_order_release,
+                                                  std::memory_order_relaxed));
+    return group;
+}
+
+#ifdef ENABLE_HITRACE
+struct Snapshot final {
+    uint64_t zeroInstanceClasses = 0;
+    uint64_t bucketCClosures = 0;
+    uint64_t bucketCNeverRead = 0;
+    uint64_t bucketCNeverCalled = 0;
+    uint64_t constructors = 0;
+    uint64_t prototypeMethods = 0;
+    uint64_t prototypeGetters = 0;
+    uint64_t prototypeSetters = 0;
+};
+
+Snapshot BuildSnapshot(VmStats *stats)
+{
+    Snapshot result;
+    for (const auto &bucket : g_buckets) {
+        for (Entry *entry = bucket.load(std::memory_order_acquire); entry != nullptr; entry = entry->next) {
+            if (entry->stats != stats || !entry->active.load(std::memory_order_acquire)) {
+                continue;
+            }
+            switch (entry->role) {
+                case NativeInteropRole::CONSTRUCTOR:
+                    ++result.constructors;
+                    if (entry->group != nullptr && !entry->group->instantiated.load(std::memory_order_relaxed)) {
+                        ++result.zeroInstanceClasses;
+                    }
+                    break;
+                case NativeInteropRole::PROTOTYPE_METHOD:
+                    ++result.prototypeMethods;
+                    break;
+                case NativeInteropRole::PROTOTYPE_GETTER:
+                    ++result.prototypeGetters;
+                    break;
+                case NativeInteropRole::PROTOTYPE_SETTER:
+                    ++result.prototypeSetters;
+                    break;
+                default:
+                    break;
+            }
+            if (entry->group != nullptr && !entry->group->instantiated.load(std::memory_order_relaxed)) {
+                ++result.bucketCClosures;
+                if ((entry->state.load(std::memory_order_relaxed) & STATE_READ) == 0) {
+                    ++result.bucketCNeverRead;
+                }
+                if ((entry->state.load(std::memory_order_relaxed) & STATE_CALLED) == 0) {
+                    ++result.bucketCNeverCalled;
+                }
+            }
+        }
+    }
+    return result;
+}
+
+void TraceCounter(const char *name, uint64_t value)
+{
+    CountTraceEx(HITRACE_LEVEL_COMMERCIAL, HITRACE_TAG_ACE, name, static_cast<int64_t>(value));
+}
+
+void TraceSnapshot(const Snapshot &snapshot)
+{
+    TraceCounter("NativeInterop.ZeroInstanceClasses", snapshot.zeroInstanceClasses);
+    TraceCounter("NativeInterop.BucketCClosures", snapshot.bucketCClosures);
+    TraceCounter("NativeInterop.BucketCNeverRead", snapshot.bucketCNeverRead);
+    TraceCounter("NativeInterop.BucketCNeverCalled", snapshot.bucketCNeverCalled);
+    TraceCounter("NativeInterop.Constructors", snapshot.constructors);
+    TraceCounter("NativeInterop.PrototypeMethods", snapshot.prototypeMethods);
+    TraceCounter("NativeInterop.PrototypeGetters", snapshot.prototypeGetters);
+    TraceCounter("NativeInterop.PrototypeSetters", snapshot.prototypeSetters);
+}
+#endif
+} // namespace
+
+void NativeInteropUsageRegistry::Enable(panda::ecmascript::EcmaVM *vm)
+{
+    if (vm == nullptr) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(g_lifecycleMutex);
+    if (FindEnabledVmStats(vm) != nullptr) {
+        return;
+    }
+    auto stats = new (std::nothrow) VmStats();
+    if (stats == nullptr) {
+        return;
+    }
+    stats->vm = vm;
+    stats->enabled.store(true, std::memory_order_relaxed);
+    VmStats *head = g_vmStatsHead.load(std::memory_order_relaxed);
+    do {
+        stats->next = head;
+    } while (!g_vmStatsHead.compare_exchange_weak(head, stats, std::memory_order_release,
+                                                  std::memory_order_relaxed));
+    g_enabledVmCount.fetch_add(1, std::memory_order_relaxed);
+}
+
+void NativeInteropUsageRegistry::Disable(panda::ecmascript::EcmaVM *vm)
+{
+    std::lock_guard<std::mutex> lock(g_lifecycleMutex);
+    VmStats *stats = FindEnabledVmStats(vm);
+    if (stats == nullptr || !stats->enabled.exchange(false, std::memory_order_acq_rel)) {
+        return;
+    }
+    for (const auto &bucket : g_buckets) {
+        for (Entry *entry = bucket.load(std::memory_order_acquire); entry != nullptr; entry = entry->next) {
+            if (entry->stats == stats) {
+                entry->active.store(false, std::memory_order_release);
+            }
+        }
+    }
+    g_enabledVmCount.fetch_sub(1, std::memory_order_relaxed);
+}
+
+void NativeInteropUsageRegistry::Register(NapiFunctionInfo *info, panda::ecmascript::EcmaVM *vm,
+                                          NativeInteropRole role, NapiFunctionInfo *constructorInfo)
+{
+    if (info == nullptr || vm == nullptr || g_enabledVmCount.load(std::memory_order_relaxed) == 0) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(g_lifecycleMutex);
+    VmStats *stats = FindEnabledVmStats(vm);
+    if (stats == nullptr) {
+        return;
+    }
+    auto entry = new (std::nothrow) Entry();
+    if (entry == nullptr) {
+        return;
+    }
+    NapiFunctionInfo *groupKey = constructorInfo == nullptr ? info : constructorInfo;
+    ClassGroup *group = role == NativeInteropRole::CONSTRUCTOR ?
+        CreateClassGroup(stats, groupKey) : FindClassGroup(stats, groupKey);
+    if (group == nullptr) {
+        delete entry;
+        return;
+    }
+    entry->info = info;
+    entry->stats = stats;
+    entry->group = group;
+    entry->role = role;
+    entry->active.store(true, std::memory_order_relaxed);
+    auto &bucket = g_buckets[BucketIndex(info)];
+    Entry *head = bucket.load(std::memory_order_relaxed);
+    do {
+        entry->next = head;
+    } while (!bucket.compare_exchange_weak(head, entry, std::memory_order_release,
+                                           std::memory_order_relaxed));
+}
+
+void NativeInteropUsageRegistry::Unregister(NapiFunctionInfo *info)
+{
+    Entry *entry = FindActiveEntry(info);
+    if (entry != nullptr) {
+        entry->active.store(false, std::memory_order_release);
+    }
+}
+
+void NativeInteropUsageRegistry::RecordCall(NapiFunctionInfo *info, bool isConstructCall)
+{
+    Entry *entry = FindActiveEntry(info);
+    if (entry == nullptr) {
+        return;
+    }
+    entry->state.fetch_or(STATE_READ | STATE_CALLED, std::memory_order_relaxed);
+    if (isConstructCall && entry->role == NativeInteropRole::CONSTRUCTOR && entry->group != nullptr) {
+        entry->group->instantiated.store(true, std::memory_order_relaxed);
+    }
+}
+
+void NativeInteropUsageRegistry::Observe(void *vm, void *functionInfo, uint8_t event)
+{
+    auto ecmaVm = reinterpret_cast<panda::ecmascript::EcmaVM *>(vm);
+    if (event == EVENT_CHECKPOINT) {
+        VmStats *stats = FindEnabledVmStats(ecmaVm);
+        if (stats == nullptr) {
+            return;
+        }
+#ifdef ENABLE_HITRACE
+        TraceSnapshot(BuildSnapshot(stats));
+#endif
+        return;
+    }
+    if (event != EVENT_READ) {
+        return;
+    }
+    Entry *entry = FindActiveEntry(reinterpret_cast<NapiFunctionInfo *>(functionInfo));
+    if (entry != nullptr && entry->stats != nullptr && entry->stats->vm == ecmaVm &&
+        entry->stats->enabled.load(std::memory_order_acquire)) {
+        entry->state.fetch_or(STATE_READ, std::memory_order_relaxed);
+    }
+}
