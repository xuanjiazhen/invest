        <mxCell id="lazyRecipe" value="NativeLazyMethodRecipe · 每槽独立分配&lt;div&gt;method 8 B | data 8 B（non-owning）&lt;/div&gt;&lt;div&gt;16 B payload；allocator actual 按目标实现计费&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#385723;fillColor=#E2F0D9;strokeColor=#548235;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="442" y="480" width="340" height="62" as="geometry"/></mxCell>
