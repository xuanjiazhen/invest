        <mxCell id="lazyHeading" value="修改后｜注册期只装惰性槽" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#385723;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="432" y="116" width="350" height="34" as="geometry"/></mxCell>
