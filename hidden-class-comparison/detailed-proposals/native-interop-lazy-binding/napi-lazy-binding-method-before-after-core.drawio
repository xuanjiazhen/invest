        <mxCell id="lifecycle" value="终态：物化 / 覆盖 / 删除 -&gt; DONE 并逐槽释放 recipe&lt;div&gt;全部终态、批量物化或 unload -&gt; 释放 directory / token（unload 先置 DEAD）&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#385723;fillColor=#F7FCF5;strokeColor=#A9D18E;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="430" y="582" width="818" height="40" as="geometry"/></mxCell>
