        <mxCell id="readHeading" value="首次读取｜物化并恢复普通槽" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#385723;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="852" y="116" width="360" height="34" as="geometry"/></mxCell>
        <mxCell id="readEntry" value="1　读取 proto.m&lt;br&gt;GetProperty(holder, key)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#3F3F3F;fillColor=#F2F2F2;strokeColor=#7F7F7F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="856" y="166" width="172" height="54" as="geometry"/></mxCell>
        <mxCell id="readLookup" value="2　CallNapiLazyGet&lt;br&gt;token + index + 当前 key" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#385723;fillColor=#E2F0D9;strokeColor=#548235;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="1050" y="166" width="172" height="54" as="geometry"/></mxCell>
        <mxCell id="readState" value="3　CAS：LAZY(recipe*) → MATERIALIZING(recipe*)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#385723;fillColor=#E2F0D9;strokeColor=#548235;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="856" y="252" width="366" height="50" as="geometry"/></mxCell>
        <mxCell id="readCreate" value="4　复用现行创建链&lt;br&gt;JSFunction → JSNativePointer&lt;br&gt;→ NapiFunctionInfo" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#3F3F3F;fillColor=#F2F2F2;strokeColor=#7F7F7F;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="856" y="330" width="174" height="74" as="geometry"/></mxCell>
        <mxCell id="readWrite" value="5　同槽写回 JSFunction&lt;br&gt;HClass / LayoutInfo 不变&lt;br&gt;显式 prototype / IC 失效" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#385723;fillColor=#E2F0D9;strokeColor=#548235;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="1050" y="330" width="172" height="74" as="geometry"/></mxCell>
        <mxCell id="readDone" value="6　发布 DONE；立即释放本槽 recipe block" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#385723;fillColor=#E2F0D9;strokeColor=#548235;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="856" y="430" width="366" height="44" as="geometry"/></mxCell>
