        <mxCell id="lazyLayout" value="HClass / LayoutInfo 与即时路径相同&lt;br&gt;key + W/E/C + offset + TAGGED&lt;br&gt;IsAccessor = false&lt;br&gt;不保存 value / recipe" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#3F3F3F;fillColor=#F2F2F2;strokeColor=#7F7F7F;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="622" y="252" width="160" height="104" as="geometry"/></mxCell>
