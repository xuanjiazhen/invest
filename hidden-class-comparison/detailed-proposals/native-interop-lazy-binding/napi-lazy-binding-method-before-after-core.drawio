        <mxCell id="title" value="Native prototype 方法：当前即时创建 -&gt; 注册期按需绑定 -&gt; 首次读取物化" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="18" width="1180" height="38" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="仅针对普通非 Sendable prototype method&lt;div&gt;未读取方法不创建函数对象；物化后恢复普通数据属性与现有 IC 语义&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5E6C84;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="34" y="55" width="1180" height="28" as="geometry"/></mxCell>

