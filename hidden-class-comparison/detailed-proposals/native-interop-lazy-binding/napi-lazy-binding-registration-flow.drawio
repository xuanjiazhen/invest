<mxfile host="app.diagrams.net" agent="Hermes Agent via @drawio/mcp 1.5.0" version="1.5.0"><diagram id="napi-41-registration" name="4.1 注册期流程"><mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1870" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="napi_define_class：按需绑定注册流程" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172B4D;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="42" as="geometry" /></mxCell><mxCell id="subtitle" value="现有函数用实线框；按需绑定拟新增函数用紫色框&lt;div&gt;每个函数框同时标明其创建、填充、发布或回收的数据结构&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5E6C84;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1620" height="34" as="geometry" /></mxCell><mxCell id="start" value="1. napi_define_class → NapiDefineClass&lt;div&gt;napi_define_class：校验输入；创建栈上 newName / EscapeLocalScope&lt;/div&gt;&lt;div&gt;NapiDefineClass：创建 constructor NapiFunctionInfo；调用 NapiCreateClassFunction&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="500" height="96" as="geometry" /></mxCell><mxCell id="decision" value="3. NapiGetKeysAndAttrsFromProps&lt;div&gt;逐属性创建 VM key，读取 W/E/C，并判断属性类型&lt;/div&gt;&lt;div&gt;当前属性是目标 prototype method？&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#FFFAE6;strokeColor=#FFAB00;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="610" y="570" width="280" height="135" as="geometry" /></mxCell><mxCell id="eager" value="3a. 其他属性：NapiInitAttrValFromProp → NapiNativeCreateFunction&lt;div&gt;创建 fullName、method NapiFunctionInfo、JSFunction、JSNativePointer&lt;/div&gt;&lt;div&gt;placement-new PropertyAttribute(value = JSFunction, W/E/C)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="80" y="750" width="380" height="125" as="geometry" /></mxCell><mxCell id="copy" value="[拟新增 2a] CreateClassBindingLifetime / RegisterLazyClass&lt;div&gt;一次性创建 environment registry entry、ClassBindingLifetime、slotDirectory[N]&lt;/div&gt;&lt;div&gt;填 slotCount / lazyCount / generation-safe token；此时 directory entry 尚未发布&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#EAE6FF;strokeColor=#6554C0;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="555" y="390" width="390" height="135" as="geometry" /></mxCell><mxCell id="mode" value="2. NapiCreateClassFunction&lt;div&gt;预扫描并统计目标 prototype method；创建临时 keys[] / PropertyAttribute[]&lt;/div&gt;&lt;div&gt;≤ 32：栈；&gt; 32：malloc backing；随后进入 NapiGetKeysAndAttrsFromProps&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#FFFAE6;strokeColor=#FFAB00;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="500" y="245" width="500" height="110" as="geometry" /></mxCell><mxCell id="a1" value="[拟新增 3b-1] CreateNativeLazyMethodRecipe&lt;div&gt;每个目标方法独立分配 recipe block；复制 {method, data}，data non-owning&lt;/div&gt;&lt;div&gt;ClassBindingLifetime / directory entry 持有 recipe 所有权&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#FFFAE6;strokeColor=#FFAB00;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1010" y="740" width="400" height="135" as="geometry" /></mxCell><mxCell id="a2" value="[拟新增 3b-2] ObjectFactory::NewNapiLazyAccessor&lt;div&gt;创建 NapiLazyAccessor，填 {token, recipeIndex}&lt;/div&gt;&lt;div&gt;placement-new PropertyAttribute(value = accessor, W/E/C)，IsAccessor = false&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#E3FCEF;strokeColor=#00875A;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="550" y="750" width="400" height="135" as="geometry" /></mxCell><mxCell id="sD" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0052CC;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="mode"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dNo" value="其他属性：即时 value" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0052CC;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="decision" target="eager"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="550" /></Array></mxGeometry></mxCell><mxCell id="dYes" value="目标方法：惰性 value" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6554C0;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="decision" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="copyMode" value="lazyCount &gt; 0：一次性创建" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6554C0;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mode" target="copy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="modeA1" value="逐属性填充" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FFAB00;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="copy" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="modeA2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00875A;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a2Done" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00875A;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.65;entryY=0;" edge="1" parent="1" source="a2" target="excluded"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eagerDone" value="即时 value 就绪" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0052CC;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="eager" target="excluded"><mxGeometry x="-0.35" relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="905" /><mxPoint x="570" y="905" /></Array></mxGeometry></mxCell><mxCell id="excluded" value="4. FunctionRef::NewConcurrentClassFunctionWithName&lt;div&gt;创建临时 PropertyDescriptor[] backing：≤ 32 使用栈，&gt; 32 使用 malloc&lt;/div&gt;&lt;div&gt;调用 CreateClassFuncWithProperties；ConstructDescByAttr placement-new 并填 value + W/E/C&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="450" y="930" width="600" height="120" as="geometry" /></mxCell>
<mxCell id="layoutFill" value="5. CreateClassFuncWithProperties → NewClassFuncProtoWithProperties&lt;div&gt;CreateClassFuncProtoHClass 创建 prototype HClass / LayoutInfo；TryAddOriKeyAndOriAttrToHClass 调 ConstructDescByAttr&lt;/div&gt;&lt;div&gt;AddInlinedPropToHClass 填 key、W/E/C、data-property、offset、TAGGED；LayoutInfo 不保存 value / recipe&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#EAE6FF;strokeColor=#6554C0;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="430" y="1090" width="640" height="135" as="geometry" /></mxCell>
<mxCell id="slotWrite" value="6a. NewClassFuncProtoWithProperties：创建 prototype 并填 property slot&lt;div&gt;NewJSObjectWithInit 创建 prototype&lt;/div&gt;&lt;div&gt;SetPropertyInlinedProps / DefinePropertyOrThrow 写 prototype.slot[i]&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#E3FCEF;strokeColor=#00875A;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="430" y="1270" width="640" height="105" as="geometry" /></mxCell>
<mxCell id="failure" value="异常出口：步骤 1-6 任一步失败&lt;div&gt;沿右侧异常总线汇聚；不发布半成品 prototype slot / directory entry&lt;/div&gt;&lt;div&gt;析构已创建 descriptor / attr，释放 heap backing；回滚 recipe、slotDirectory、token、lifetime；向调用方传播异常&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;spacing=6;fillColor=#FFEBE6;strokeColor=#DE350B;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1080" y="1690" width="500" height="130" as="geometry" /></mxCell>
<mxCell id="failureEdge" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#DE350B;strokeWidth=1.5;fontSize=9;fontColor=#DE350B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1610" y="1755" as="sourcePoint" /><mxPoint x="1580" y="1755" as="targetPoint" /></mxGeometry></mxCell>
<mxCell id="descLayout" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6554C0;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="excluded" target="layoutFill"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="layoutSlot" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00875A;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="layoutFill" target="slotWrite"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="slotPublish" value="[拟新增] 6b. PublishLazySlot&lt;div&gt;全部 property slot 写入成功后，发布 slotDirectory[i] = LAZY(recipe*)&lt;/div&gt;&lt;div&gt;发布前 accessor 不可见；失败路径不留下半发布 directory entry&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;spacing=8;fillColor=#E3FCEF;strokeColor=#00875A;strokeWidth=2;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="500" y="1410" width="500" height="100" as="geometry" /></mxCell><mxCell id="slotCleanup" value="6c. 临时结构析构与 backing 回收&lt;div&gt;DestructDesc / DestructAttr 逐项析构&lt;/div&gt;&lt;div&gt;NewConcurrentClassFunctionWithName free(descs)；NapiCreateClassFunction free(keys / attrs)；栈 backing 随返回失效&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;spacing=8;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=2;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="430" y="1545" width="640" height="110" as="geometry" /></mxCell><mxCell id="slotToPublish" value="slot 写入全部成功" style="endArrow=block;endFill=1;html=1;strokeColor=#00875A;strokeWidth=2;fontSize=10;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="1375" as="sourcePoint" /><mxPoint x="750" y="1410" as="targetPoint" /></mxGeometry></mxCell><mxCell id="publishToCleanup" value="发布完成后回收临时转换结构" style="endArrow=block;endFill=1;html=1;strokeColor=#00875A;strokeWidth=2;fontSize=10;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="1510" as="sourcePoint" /><mxPoint x="750" y="1545" as="targetPoint" /></mxGeometry></mxCell><mxCell id="failureRailLabel" value="异常总线&lt;div&gt;步骤 1-6 任一步失败&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;spacing=5;fillColor=#FFEBE6;strokeColor=#DE350B;strokeWidth=1.5;fontColor=#DE350B;" vertex="1" parent="1"><mxGeometry x="1510" y="95" width="170" height="58" as="geometry" /></mxCell><mxCell id="failureRail" value="" style="endArrow=none;html=1;strokeColor=#DE350B;strokeWidth=2;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1610" y="153" as="sourcePoint" /><mxPoint x="1610" y="1755" as="targetPoint" /></mxGeometry></mxCell><mxCell id="fStage1" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#DE350B;strokeWidth=1.5;fontSize=9;fontColor=#DE350B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="158" as="sourcePoint" /><mxPoint x="1610" y="158" as="targetPoint" /></mxGeometry></mxCell><mxCell id="fStage2" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#DE350B;strokeWidth=1.5;fontSize=9;fontColor=#DE350B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="300" as="sourcePoint" /><mxPoint x="1610" y="300" as="targetPoint" /></mxGeometry></mxCell><mxCell id="fStage3" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#DE350B;strokeWidth=1.5;fontSize=9;fontColor=#DE350B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="637" as="sourcePoint" /><mxPoint x="1610" y="637" as="targetPoint" /></mxGeometry></mxCell><mxCell id="fStage4" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#DE350B;strokeWidth=1.5;fontSize=9;fontColor=#DE350B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="990" as="sourcePoint" /><mxPoint x="1610" y="990" as="targetPoint" /></mxGeometry></mxCell><mxCell id="fStage5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#DE350B;strokeWidth=1.5;fontSize=9;fontColor=#DE350B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="1157" as="sourcePoint" /><mxPoint x="1610" y="1157" as="targetPoint" /></mxGeometry></mxCell><mxCell id="fStage6a" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#DE350B;strokeWidth=1.5;fontSize=9;fontColor=#DE350B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="1322" as="sourcePoint" /><mxPoint x="1610" y="1322" as="targetPoint" /></mxGeometry></mxCell><mxCell id="fStage6b" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#DE350B;strokeWidth=1.5;fontSize=9;fontColor=#DE350B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="1460" as="sourcePoint" /><mxPoint x="1610" y="1460" as="targetPoint" /></mxGeometry></mxCell><mxCell id="fStage6c" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#DE350B;strokeWidth=1.5;fontSize=9;fontColor=#DE350B;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="1600" as="sourcePoint" /><mxPoint x="1610" y="1600" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>