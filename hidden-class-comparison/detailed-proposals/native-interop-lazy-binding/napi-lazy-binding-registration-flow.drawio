<mxfile host="app.diagrams.net" agent="Hermes Agent via @drawio/mcp 1.5.0" version="1.5.0"><diagram id="napi-41-registration" name="4.1 注册期流程"><mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="napi_define_class：按需绑定注册流程" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172B4D;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="42" as="geometry" /></mxCell><mxCell id="subtitle" value="注册期填充链：keys / attrs / descriptors 与 HClass / LayoutInfo 保持相同&lt;div&gt;目标 prototype method 仅改变 value 创建与持久回调表示&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5E6C84;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1420" height="34" as="geometry" /></mxCell><mxCell id="start" value="遍历 properties[]，保持 static / prototype 顺序" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="580" y="120" width="340" height="60" as="geometry" /></mxCell><mxCell id="decision" value="当前属性属于按需绑定目标？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#FFFAE6;strokeColor=#FFAB00;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="610" y="225" width="280" height="120" as="geometry" /></mxCell><mxCell id="eager" value="当前即时创建路径&lt;div&gt;填充相同 keys[] / attrs[]：key + W/E/C&lt;/div&gt;&lt;div&gt;目标 method 注册期创建 JSFunction；attrs.value = JSFunction&lt;/div&gt;&lt;div&gt;其他属性保持现有处理&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="120" y="420" width="350" height="110" as="geometry" /></mxCell><mxCell id="copy" value="确保 ClassBindingLifetime 已创建&lt;div&gt;注册 token 与 environment cleanup&lt;/div&gt;&lt;div&gt;只复制 {method, data}&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#EAE6FF;strokeColor=#6554C0;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="575" y="405" width="350" height="125" as="geometry" /></mxCell><mxCell id="mode" value="填充临时 keys[] / attrs[]&lt;div&gt;String / Symbol key + W/E/C&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#FFFAE6;strokeColor=#FFAB00;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1030" y="405" width="360" height="125" as="geometry" /></mxCell><mxCell id="a1" value="目标方法：分配 recipe + directory entry&lt;div&gt;NativeLazyMethodRecipe {method, data}&lt;/div&gt;&lt;div&gt;slotDirectory[i] = LAZY(recipe*)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#FFFAE6;strokeColor=#FFAB00;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1030" y="585" width="360" height="125" as="geometry" /></mxCell><mxCell id="a2" value="PropertyAttribute.value = NapiLazyAccessor&lt;div&gt;payload = {token, recipeIndex}&lt;/div&gt;&lt;div&gt;其他属性 value 仍即时创建&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#E3FCEF;strokeColor=#00875A;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="575" y="585" width="350" height="125" as="geometry" /></mxCell><mxCell id="sD" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0052CC;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dNo" value="其他属性：即时 value" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0052CC;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="decision" target="eager"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="285" /><mxPoint x="295" y="285" /></Array></mxGeometry></mxCell><mxCell id="dYes" value="目标方法：惰性 value" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6554C0;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="decision" target="copy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="copyMode" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6554C0;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="copy" target="mode"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="modeA1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FFAB00;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mode" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="modeA2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00875A;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a2Done" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00875A;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.65;entryY=0;" edge="1" parent="1" source="a2" target="excluded"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eagerDone" value="即时 value 就绪" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0052CC;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="eager" target="excluded"><mxGeometry x="-0.35" relative="1" as="geometry"><Array as="points"><mxPoint x="295" y="720" /><mxPoint x="582" y="720" /></Array></mxGeometry></mxCell><mxCell id="excluded" value="1  构造临时 PropertyDescriptor[]&lt;div&gt;两路径均为 data property，key / W/E/C / 排序相同&lt;/div&gt;&lt;div&gt;仅 value：JSFunction 或 NapiLazyAccessor&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="470" y="760" width="560" height="76" as="geometry" /></mxCell>
<mxCell id="layoutFill" value="2  填充 prototype HClass / LayoutInfo&lt;div&gt;两路径内容相同：全部 key、属性数、inline capacity、W/E/C、IsAccessor=false、offset、TAGGED&lt;/div&gt;&lt;div&gt;LayoutInfo 不保存 value、recipe 或 callback&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#EAE6FF;strokeColor=#6554C0;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="470" y="865" width="560" height="82" as="geometry" /></mxCell>
<mxCell id="slotWrite" value="3  创建 prototype 并按 descriptor offset 填充 value slot&lt;div&gt;即时：slot[i] = JSFunction；按需：slot[i] = NapiLazyAccessor&lt;/div&gt;&lt;div&gt;失败时回收对应 runtime state；临时 keys / attrs / descriptors 在返回后结束生命周期&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#E3FCEF;strokeColor=#00875A;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="470" y="976" width="560" height="88" as="geometry" /></mxCell>
<mxCell id="descLayout" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6554C0;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="excluded" target="layoutFill"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="layoutSlot" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00875A;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="layoutFill" target="slotWrite"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
