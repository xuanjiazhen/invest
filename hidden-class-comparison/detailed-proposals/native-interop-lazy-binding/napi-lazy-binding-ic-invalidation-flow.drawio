<mxfile host="app.diagrams.net" agent="Hermes Agent via @drawio/mcp 1.5.0" version="1.5.0"><diagram id="napi-43-ic" name="4.3 写回与 IC 失效"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Prototype 方法物化写回与 inline cache 失效" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172B4D;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1420" height="42" as="geometry" /></mxCell><mxCell id="subtitle" value="同一 property slot 替换为 JSFunction；HClass / LayoutInfo 不变，但必须显式执行 prototype invalidation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5E6C84;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1420" height="34" as="geometry" /></mxCell><mxCell id="builtin" value="写回前 identity check" style="swimlane;html=1;horizontal=1;startSize=34;rounded=1;arcSize=6;fillColor=#DEEBFF;swimlaneFillColor=#FFFFFF;strokeColor=#0052CC;strokeWidth=1.5;fontSize=14;fontStyle=1;fontColor=#172B4D;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="640" height="570" as="geometry" /></mxCell><mxCell id="reset" value="重新读取 holder[key]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#DEEBFF;strokeColor=#0052CC;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="130" y="205" width="480" height="95" as="geometry" /></mxCell><mxCell id="dict" value="当前属性仍是同一个 NapiLazyAccessor？" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#FFFAE6;strokeColor=#FFAB00;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="160" y="360" width=