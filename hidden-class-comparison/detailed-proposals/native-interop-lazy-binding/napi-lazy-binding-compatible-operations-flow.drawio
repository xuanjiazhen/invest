o.m" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#FFFAE6;strokeColor=#FFAB00;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="910" y="300" width="250" height="70" as="geometry" /></mxCell><mxCell id="deleter" value="configurable：删除惰性槽，不物化&lt;div&gt;发布终态后释放 recipe；否则沿当前失败语义&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#FFFAE6;strokeColor=#FFAB00;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="910" y="510" width="250" height="145" as="geometry" /></mxCell><mxCell id="branch3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FFAB00;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="op" target="delete"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="230" /><mxPoint x="1035" y="230" /></Array></mxGeometry></mxCell><mxCell id="rule3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FFAB00;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#172B4D;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="delete" target="deleter"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="enum" value="for...in / Object.keys / entries / spread" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#E3FCEF;strokeColor=#00875A;strokeWidth=1.5;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1200" y="300" width="250" height="70" as="geometry" /></mxCell><mxCell id="enumr" value="for...in / Object.keys：只枚举键，不物化&lt;div&gt;Object.entries / spread：按实际读取的 value 逐槽物化&lt;/div&gt;" style="rounded=1;arcSize=8