<mxfile host="app.diagrams.net" agent="Hermes Agent via @drawio/mcp 1.5.0" version="1.5.0">
  <diagram id="jshclass-auxdata-architecture" name="核心技术架构"><mxGraphModel dx="1560" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="980" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="JSHClass AuxData Sidecar 核心技术架构" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="50" y="28" width="940" height="34" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="统一 64 B 主对象 + 按需 4 槽强 sidecar；保持对象模型语义，收敛 compiled / GC / serializer / DFX 内部契约" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="50" y="62" width="1180" height="24" as="geometry" /></mxCell>
        <mxCell id="metric" value="Top13 稳态浅层模型&#10;主对象 88 B → 64 B&#10;净收益 17.724 MiB" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;" vertex="1" parent="1"><mxGeometry x="1300" y="24" width="240" height="66" as="geometry" /></mxCell>

        <mxCell id="runtimeBoundary" value="ArkVM Runtime 核心对象模型" style="swimlane;horizontal=1;startSize=32;rounded=1;html=1;fillColor=#F4F5F7;swimlaneFillColor=#EBECF0;strokeColor=#7A869A;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="900" height="430" as="geometry" /></mxCell>

        <mxCell id="writers" value="状态写入入口&#10;&#10;• 原型注册 / RefreshUsers&#10;• for-in 创建 EnumCache&#10;• lazy-deopt 安装依赖" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;verticalAlign=middle;fontSize=12;fillColor=#FFF0B3;strokeColor=#FFAB00;strokeWidth=2;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="50" y="230" width="230" height="150" as="geometry" /></mxCell>
        <mxCell id="defaultWrite" value="写默认值&#10;aux == Null" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#F4F5F7;strokeColor=#A5ADBA;fontColor=#42526E;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="170" height="60" as="geometry" /></mxCell>

        <mxCell id="helper" value="统一 helper&#10;GetAuxField / SetAuxField" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#DEEBFF;strokeColor=#0065FF;strokeWidth=2;fontColor=#0747A6;" vertex="1" parent="runtimeBoundary"><mxGeometry x="45" y="88" width="210" height="78" as="geometry" /></mxCell>
        <mxCell id="decision" value="AuxData == Null?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#EAE6FF;strokeColor=#6554C0;strokeWidth=2;fontColor=#403294;" vertex="1" parent="runtimeBoundary"><mxGeometry x="310" y="83" width="155" height="90" as="geometry" /></mxCell>
        <mxCell id="slowPath" value="首次非默认写 slow path&#10;&#10;VM mutex 二次检查&#10;初始化全部 4 槽&#10;release-publish&#10;禁止 no-GC 区间分配" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;verticalAlign=middle;fontSize=11;fillColor=#FFEBE6;strokeColor=#DE350B;strokeWidth=2;fontColor=#BF2600;" vertex="1" parent="runtimeBoundary"><mxGeometry x="535" y="46" width="235" height="160" as="geometry" /></mxCell>

        <mxCell id="hclass" value="JSHClass 64 B&#10;&#10;0–47 B：Header / BitFields / Proto / Layout / Transitions / Parent&#10;&#10;48 B：AuxData 强引用&#10;56 B：BitField2" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=3;fontColor=#006644;" vertex="1" parent="runtimeBoundary"><mxGeometry x="110" y="240" width="290" height="145" as="geometry" /></mxCell>
        <mxCell id="sidecar" value="TaggedArray(4) · 48 B&#10;&#10;[0] ProtoChangeMarker = Null&#10;[1] ProtoChangeDetails = Null&#10;[2] EnumCache = Null&#10;[3] DependentInfos = Undefined" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;verticalAlign=middle;fontSize=11;fontStyle=1;fillColor=#EAE6FF;strokeColor=#6554C0;strokeWidth=3;fontColor=#403294;" vertex="1" parent="runtimeBoundary"><mxGeometry x="500" y="245" width="270" height="145" as="geometry" /></mxCell>
        <mxCell id="strongSemantics" value="强引用语义不变&#10;不引入 weak key / ephemeron / 全局表" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=10;fillColor=#F4F5F7;strokeColor=#7A869A;fontColor=#42526E;" vertex="1" parent="runtimeBoundary"><mxGeometry x="500" y="208" width="270" height="31" as="geometry" /></mxCell>

        <mxCell id="compiled" value="Compiled / IC / AOT&#10;&#10;getter：AuxData fast path&#10;setter：已有 sidecar 直接写&#10;首次写调用 runtime helper&#10;旧四个固定 offset 引用归零" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;verticalAlign=middle;fontSize=11;fillColor=#DEEBFF;strokeColor=#0065FF;strokeWidth=2;fontColor=#0747A6;" vertex="1" parent="1"><mxGeometry x="1280" y="145" width="260" height="145" as="geometry" /></mxCell>
        <mxCell id="semantic" value="语义消费者&#10;&#10;• 原型链 / IC 失效&#10;• for-in / 枚举缓存&#10;• JIT lazy-deopt&#10;• Clone / transition" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;verticalAlign=middle;fontSize=11;fillColor=#FFF0B3;strokeColor=#FFAB00;strokeWidth=2;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1280" y="335" width="260" height="145" as="geometry" /></mxCell>

        <mxCell id="gc" value="GC 与生命周期&#10;&#10;JSHClass 存活 → sidecar / payload 存活&#10;JSHClass 死亡 → 普通可达性回收&#10;visitor：主对象 8 槽 → 5 槽&#10;TaggedArray 复用现有 barrier / moving GC" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;verticalAlign=middle;fontSize=11;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;" vertex="1" parent="1"><mxGeometry x="50" y="625" width="350" height="150" as="geometry" /></mxCell>
        <mxCell id="serializer" value="Serializer / Snapshot / DFX&#10;&#10;序列化 AuxData = Null，运行时重建&#10;dump / rawheap 映射回 4 个逻辑字段&#10;heap verification 覆盖有/无 sidecar" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;verticalAlign=middle;fontSize=11;fillColor=#DEEBFF;strokeColor=#0065FF;strokeWidth=2;fontColor=#0747A6;" vertex="1" parent="1"><mxGeometry x="440" y="625" width="350" height="150" as="geometry" /></mxCell>
        <mxCell id="compat" value="内部版本契约&#10;&#10;bump .an / .ai / rawheap metadata&#10;strict match 拒绝旧产物&#10;clean rebuild snapshot / AOT / stub&#10;static_assert SIZE = 64" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;verticalAlign=middle;fontSize=11;fillColor=#FFEBE6;strokeColor=#DE350B;strokeWidth=2;fontColor=#BF2600;" vertex="1" parent="1"><mxGeometry x="830" y="625" width="350" height="150" as="geometry" /></mxCell>
        <mxCell id="rollout" value="分阶段上库与门禁&#10;&#10;S1：96 B 双写验证（不进产品）&#10;S2：64 B 删槽 + 全消费者切换&#10;S3：metadata / dump / CI 收尾&#10;correctness + GC + PSS + 性能 A/B" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;verticalAlign=middle;fontSize=11;fillColor=#EAE6FF;strokeColor=#6554C0;strokeWidth=2;fontColor=#403294;" vertex="1" parent="1"><mxGeometry x="1220" y="625" width="320" height="150" as="geometry" /></mxCell>

        <mxCell id="note1" value="默认写：零分配" style="text;html=1;align=center;fontSize=10;fontStyle=2;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="265" y="440" width="140" height="20" as="geometry" /></mxCell>
        <mxCell id="note2" value="首次写：按需创建" style="text;html=1;align=center;fontSize=10;fontStyle=2;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="875" y="180" width="150" height="20" as="geometry" /></mxCell>

        <mxCell id="e1" value="写逻辑字段" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FFAB00;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="writers" target="helper"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="默认值" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7A869A;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="defaultWrite" target="helper"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="检查" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0065FF;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="runtimeBoundary" source="helper" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="Null + 非默认" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DE350B;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="runtimeBoundary" source="decision" target="slowPath"><mxGeometry relative="1" as="geometry" /></mxCell>
